; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Empires of Olympus"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/low_processor_usage_mode=false
run/delta_smoothing=true

[audio]

driver/output_latency.web=100

[autoload]

LoadingScreen="*res://scripts/autoloads/loading_screen.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
GameState="*res://scripts/autoloads/game_state.gd"
AccountSystem="*res://scripts/autoloads/account_system.gd"
ChatSystem="*res://scripts/autoloads/chat_system.gd"
DisplaySettings="*res://scripts/autoloads/display_settings.gd"
PartyShare="*res://scripts/autoloads/party_share.gd"
SocialSystem="*res://scripts/autoloads/social_system.gd"
NetSession="*res://scripts/autoloads/net_session.gd"
ServerBrowser="*res://scripts/autoloads/server_browser.gd"
TesanaWorldEditor="*res://addons/tesana_world_editor/scene_export.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/zylann.hterrain/plugin.cfg")

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/lossy_quality": 0.75,
"compress/mode": 1,
"compress/normal_map": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 1024,
"roughness/mode": 0
}
sample={
"compress/mode": 1,
"edit/loop_begin": 0,
"edit/loop_end": -1,
"edit/loop_mode": 0,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": true,
"force/max_rate_hz": 22050,
"force/max_rate_mode": 0,
"force/mono": false
}

