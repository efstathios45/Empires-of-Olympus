[rendering]

## Vulkan Forward+ saturates modern GPUs; Compatibility (OpenGL) left GPU idle.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_texture_filter=3
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.14, 1)

[physics]

common/physics_ticks_per_second=60
3d/run_on_separate_thread=true
