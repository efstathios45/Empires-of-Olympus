; Engine configuration file — DO NOT hand-edit header.

config_version=5

[application]

config/name="Empires of Olympus"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

LoadingScreen="*res://scripts/autoloads/loading_screen.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
GameState="*res://scripts/autoloads/game_state.gd"
AccountSystem="*res://scripts/autoloads/account_system.gd"
TesanaWorldEditor="*res://addons/tesana_world_editor/scene_export.gd"

[audio]

general/default_playback_type.web=1
driver/output_latency.web=100

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/zylann.hterrain/plugin.cfg")

